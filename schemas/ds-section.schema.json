{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/ds-section.schema.json",
  "title": "Design System First token-map section",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "local_selectors", "local_files", "ds_sources", "knowledge_ids"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status": { "enum": ["REUSE", "COMPOSE", "EXTEND", "BLOCKED"] },
    "html_selector": { "type": "string", "minLength": 1 },
    "local_selectors": { "type": "array", "items": { "type": "string" } },
    "local_files": { "type": "array", "items": { "type": "string" } },
    "ds_sources": { "type": "array", "items": { "type": "string" } },
    "knowledge_ids": { "type": "array", "items": { "type": "string", "pattern": "^KBP-[0-9]{4}$" } },
    "decision": { "enum": ["pending", "approved-partial", "approved-extension"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["EXTEND", "BLOCKED"] } }, "required": ["status"] },
      "then": { "required": ["decision"] }
    }
  ]
}
