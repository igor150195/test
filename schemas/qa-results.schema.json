{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/qa-results.schema.json",
  "title": "Codex project QA results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "generator_version", "ds_version", "chromium_version", "portable", "pages", "technical", "expert"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "ds_version": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "chromium_version": { "type": ["string", "null"] },
    "portable": { "type": "boolean" },
    "pages": { "type": "array" },
    "technical": {
      "type": "object",
      "required": ["status", "checks", "summary", "ds_usage", "portability", "a11y"],
      "properties": {
        "status": { "enum": ["pass", "fail", "not-run"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "count", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["passed", "warning", "error", "skipped", "not-run"] },
              "count": { "type": "integer", "minimum": 0 },
              "reason": { "type": "string" },
              "evidence": { "type": "array" }
            }
          }
        },
        "summary": { "type": "object" },
        "ds_usage": {
          "type": "object",
          "required": ["status", "all_class_uses", "ds_class_uses"],
          "properties": {
            "status": { "enum": ["passed", "error", "not-run"] },
            "all_class_uses": { "type": "integer", "minimum": 0 },
            "ds_class_uses": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          }
        },
        "portability": {
          "type": "object",
          "required": ["site_build", "check_site", "external_resources"],
          "properties": {
            "site_build": { "$ref": "#/$defs/portableCheck" },
            "check_site": { "$ref": "#/$defs/portableCheck" },
            "external_resources": { "$ref": "#/$defs/portableCheck" }
          }
        },
        "a11y": {
          "type": "object",
          "required": ["status", "violations"],
          "properties": {
            "status": { "enum": ["passed", "warning", "error", "incomplete", "not-run"] },
            "reason": { "type": "string" },
            "violations": { "type": "array" },
            "incomplete": {
              "type": "object",
              "required": ["count", "findings"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "findings": { "type": "array" }
              }
            }
          }
        }
      }
    },
    "expert": {
      "type": "object",
      "required": ["status", "score", "findings"],
      "properties": {
        "status": { "enum": ["not-reviewed", "agent-reviewed"] },
        "score": { "type": "null" },
        "findings": { "type": "array" }
      }
    }
  },
  "$defs": {
    "portableCheck": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["passed", "error", "not-run"] },
        "reason": { "type": "string" },
        "response_count": { "type": "integer", "minimum": 0 },
        "resources": { "type": "array" }
      }
    }
  }
}
