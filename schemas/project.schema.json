{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/project.schema.json",
  "title": "Codex static-site project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "type",
    "mode",
    "platform",
    "generator_version",
    "ds_version",
    "pages",
    "files",
    "external_dependencies"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["reference", "brief"] },
    "platform": { "const": "static-html" },
    "generator_version": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "ds_version": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "output", "route"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string", "pattern": "^[^/].*\\.html$" },
          "output": { "type": "string", "pattern": "^[^/].*\\.html$" },
          "route": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owner": { "enum": ["generated", "owner"] }
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "required"],
        "properties": {
          "kind": { "enum": ["reference", "image", "video", "link", "font", "other"] },
          "url": { "type": "string", "pattern": "^https://" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
