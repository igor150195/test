{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/project.schema.json",
  "title": "Codex static-site project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "type",
    "mode",
    "platform",
    "generator_version",
    "ds_version",
    "compliance",
    "pages",
    "files",
    "external_dependencies"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["reference", "brief"] },
    "platform": { "const": "static-html" },
    "generator_version": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "ds_version": { "type": "string", "pattern": "^git:[0-9a-f]{40}$" },
    "compliance": { "enum": ["legacy", "strict"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "primary_surface",
        "on_primary",
        "accent",
        "accent_surface",
        "on_accent",
        "bg_main",
        "bg_main_surface",
        "on_bg_main",
        "on_bg_main_accent"
      ],
      "properties": {
        "primary": { "$ref": "#/$defs/hexColor" },
        "primary_surface": { "$ref": "#/$defs/hexColor" },
        "on_primary": { "$ref": "#/$defs/hexColor" },
        "accent": { "$ref": "#/$defs/hexColor" },
        "accent_surface": { "$ref": "#/$defs/hexColor" },
        "on_accent": { "$ref": "#/$defs/hexColor" },
        "bg_main": { "$ref": "#/$defs/hexColor" },
        "bg_main_surface": { "$ref": "#/$defs/hexColor" },
        "on_bg_main": { "$ref": "#/$defs/hexColor" },
        "on_bg_main_accent": { "$ref": "#/$defs/hexColor" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "output", "route"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string", "pattern": "^[^/].*\\.html$" },
          "output": { "type": "string", "pattern": "^[^/].*\\.html$" },
          "route": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owner": { "enum": ["generated", "owner"] }
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "required"],
        "properties": {
          "kind": { "enum": ["reference", "image", "video", "link", "font", "other"] },
          "url": { "type": "string", "pattern": "^https://" },
          "required": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
